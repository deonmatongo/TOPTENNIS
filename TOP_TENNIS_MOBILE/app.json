{
  "expo": {
    "name": "TopTennis",
    "slug": "toptennis",
    "version": "1.0.2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "toptennis",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toptennis.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Top Tennis uses your camera for video calls and profile photos.",
        "NSMicrophoneUsageDescription": "Top Tennis uses your microphone for voice and video calls.",
        "NSPhotoLibraryUsageDescription": "Top Tennis accesses your photo library to let you choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Top Tennis saves photos to your library.",
        "NSCalendarsUsageDescription": "Top Tennis adds your upcoming matches to your calendar.",
        "NSUserNotificationsUsageDescription": "Top Tennis sends you match reminders and league updates.",
        "NSLocationWhenInUseUsageDescription": "Top Tennis uses your location to find nearby courts and players.",
        "NSFaceIDUsageDescription": "Top Tennis uses Face ID to quickly and securely unlock the app.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "bitcode": false
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F97316"
      },
      "package": "com.toptennis.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F97316",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Top Tennis accesses your photos to let you set a profile picture.",
          "cameraPermission": "Top Tennis uses your camera to take a profile photo."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Top Tennis adds your matches to your calendar."
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "expo-web-browser",
      "@config-plugins/react-native-webrtc",
      "@sentry/react-native/expo",
      "./plugins/android-permissions"
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#F97316",
      "iosDisplayInForeground": true
    },
    "updates": {
      "url": "https://u.expo.dev/4219d217-f2a1-4f6f-a40b-4e85742eb6c8"
    },
    "extra": {
      "eas": {
        "projectId": "4219d217-f2a1-4f6f-a40b-4e85742eb6c8"
      }
    },
    "owner": "davemato"
  }
}
