# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── LiveKit (voice & video calls) ───────────────────────────────────────────
# Found in: LiveKit Cloud dashboard → Project → Keys
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# These go in Supabase Dashboard → Edge Functions → Secrets (NOT in .env)
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── Setup Instructions ───────────────────────────────────────────────────────
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your actual values from the Supabase dashboard
# 3. Never commit .env to git (it is already in .gitignore)
# 4. For EAS builds, set these in: eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
#    or via the Expo dashboard: https://expo.dev → Project → Secrets
