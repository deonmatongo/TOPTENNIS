# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Also needed by the website (Vite uses VITE_ prefix)
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── LiveKit (voice & video calls) ───────────────────────────────────────────
# Found in: LiveKit Cloud dashboard → Project → Keys
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# These go in Supabase Dashboard → Edge Functions → Secrets (NOT in .env)
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── Sentry (crash reporting) ────────────────────────────────────────────────
# Found in: sentry.io → Project → Settings → Client Keys (DSN)
# Without this, crash reporting is silently disabled in production.
EXPO_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
#
# The three variables below are BUILD-TIME only (used by EAS to upload source maps).
# Set them as EAS secrets, NOT in .env:
#   eas secret:create --scope project --name SENTRY_ORG --value "your-org-slug"
#   eas secret:create --scope project --name SENTRY_PROJECT --value "your-project-slug"
#   eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value "sntrys_..."
# Found in: sentry.io → Settings → Auth Tokens (create one with project:releases scope)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...

# ─── Support backend (server only — never in the app bundle) ─────────────────
PORT=3001
WEBHOOK_BASE_URL=https://your-server.example.com
# Twilio — found in: console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Anthropic — found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Setup Instructions ───────────────────────────────────────────────────────
# 1. Copy this file:    cp .env.example .env
# 2. Fill in values from each dashboard listed above
# 3. Never commit .env — it is in .gitignore
# 4. For EAS production builds, set EXPO_PUBLIC_* as EAS secrets:
#      eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
#    Sentry build-time vars (SENTRY_ORG etc.) go in EAS secrets too — see above.
