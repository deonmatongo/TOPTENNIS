# Environment variables for one-off admin scripts.
# Copy to scripts/.env and fill in real values — never commit that file.
# scripts/.env is covered by the root .gitignore (.env pattern).
#
# Run with:
#   node --env-file=scripts/.env scripts/<script-name>.mjs

# ─── Supabase admin access ────────────────────────────────────────────────────
# Settings → API → Service role key (rotate in the dashboard if compromised)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── create-demo-account.mjs ─────────────────────────────────────────────────
DEMO_PHONE=+11234567890
DEMO_PASSWORD=ChooseAStrongPassword!
