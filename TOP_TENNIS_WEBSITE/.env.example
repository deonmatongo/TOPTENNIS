# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# ─── Twilio Verify (WhatsApp OTP) ─────────────────────────────────────────────
# These are SERVER-SIDE secrets — set via Supabase Edge Function secrets,
# NOT as VITE_ prefixed variables. They must NOT be exposed to the browser.
#
# Set with:
#   supabase secrets set TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set TWILIO_AUTH_TOKEN=your_auth_token
#   supabase secrets set TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Get these from: https://console.twilio.com/
#   TWILIO_ACCOUNT_SID      → Twilio Console > Account Info
#   TWILIO_AUTH_TOKEN       → Twilio Console > Account Info
#   TWILIO_VERIFY_SERVICE_SID → Twilio Console > Verify > Services > (create one)
#
# WhatsApp channel requirement:
#   Your Verify Service must have WhatsApp enabled.
#   Apply at: https://console.twilio.com/us1/develop/verify/services
#   For local testing, use Twilio's WhatsApp Sandbox first.
