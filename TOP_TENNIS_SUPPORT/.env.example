# ─── Twilio (shared with OTP service — same credentials) ──────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The WhatsApp-enabled sender number from Twilio Console
# Format: +14155238886  (no "whatsapp:" prefix here — added in code)
TWILIO_WHATSAPP_FROM=+14155238886

# Webhook base URL for Twilio to reach this service
# In dev: use ngrok/cloudflared — e.g. https://abc123.ngrok.io
# In prod: your deployed service URL
WEBHOOK_BASE_URL=https://your-domain.com

# ─── Session window tracking ───────────────────────────────────────────────────
# How long (ms) to consider a conversation "open" before requiring a template.
# Meta enforces 24h — keep this at or below 86400000.
SESSION_WINDOW_MS=86400000

# ─── AI triage (required) ──────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Chatwoot (Scenario 1 — only needed if bridging to Chatwoot) ──────────────
# CHATWOOT_BASE_URL=https://app.chatwoot.com
# CHATWOOT_API_TOKEN=your_chatwoot_user_token
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_INBOX_ID=2

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
