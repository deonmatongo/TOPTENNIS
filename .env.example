# Single root .env for all platforms — copy to .env and fill in values.
# Website reads VITE_ vars, mobile reads EXPO_PUBLIC_ vars, support reads bare vars.
# The Supabase URL and anon key appear under both prefixes — same value, edit both lines.

# ─── Supabase — Website (Vite requires VITE_ prefix) ─────────────────────────
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Supabase — Mobile (Expo requires EXPO_PUBLIC_ prefix) ───────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Mobile — LiveKit (voice/video calls) ────────────────────────────────────
# Get from LiveKit Cloud dashboard → Project → Keys
# API key and secret go in Supabase Edge Function secrets, NOT here
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Mobile — Sentry (crash reporting) ───────────────────────────────────────
# Get from sentry.io → Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX

# ─── Support service — Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886
WEBHOOK_BASE_URL=https://your-domain.com

# ─── Support service — Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Support service — Optional Chatwoot bridge ───────────────────────────────
# CHATWOOT_BASE_URL=https://your-chatwoot.com
# CHATWOOT_API_TOKEN=your_token
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_INBOX_ID=1

# ─── Support service — Server config ─────────────────────────────────────────
PORT=3001
NODE_ENV=development
